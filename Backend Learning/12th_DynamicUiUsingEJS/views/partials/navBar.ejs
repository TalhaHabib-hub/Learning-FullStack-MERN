<header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
  <a href="/" class="text-2xl font-bold tracking-tight text-rose-500">
    Airbnb
  </a>
  <% if (pageTitle === 'Home') { %>
    <a
      href="/host/add_home"
      class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:border-rose-200 hover:text-rose-600"
    >
      Become a host
    </a>
  <% } else { %>
    <a
      href="/"
      class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:border-rose-200 hover:text-rose-600"
    >
      Back to homes
    </a>
  <% } %>
</header>