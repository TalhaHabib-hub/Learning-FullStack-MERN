<%- include('partials/head.ejs') %>
  <body class="min-h-screen bg-gradient-to-br from-rose-50 via-white to-slate-100 text-slate-800">
    <%- include('partials/navBar.ejs') %>

    <main class="mx-auto max-w-5xl px-6 py-10 md:py-16">
      <section
        class="rounded-3xl bg-white p-8 shadow-xl shadow-slate-200/70 ring-1 ring-slate-200 md:p-12"
      >
        <p
          class="mb-3 text-xs font-semibold uppercase tracking-[0.28em] text-rose-500"
        >
          Host with us
        </p>
        <h1
          class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl"
        >
          Share your space.
        </h1>
        <p class="mt-4 max-w-lg text-lg text-slate-600">
          Start with a name guests will remember.
        </p>

        <form method="POST" action="/host/add_home" class="mt-8 max-w-xl" enctype="multipart/form-data">
          <label
            for="addedHome"
            class="mb-2 block text-sm font-medium text-slate-700"
            >Home name</label
          >
          <div class="flex flex-col gap-4 sm:flex-row">
            <input
              id="addedHome"
              type="text"
              name="addedHome"
              placeholder="e.g. The garden house"
              required
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-base text-slate-900 placeholder:text-slate-400 focus:border-rose-400 focus:outline-none focus:ring-4 focus:ring-rose-100"
            />
            <input
              id="pricePerNight"
              type="text"
              name="pricePerNight"
              placeholder="e.g. $100"
              required
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-base text-slate-900 placeholder:text-slate-400 focus:border-rose-400 focus:outline-none focus:ring-4 focus:ring-rose-100"
            />
            <input
              id="location"
              type="text"
              name="location"
              placeholder="e.g. New York, NY"
              required
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-base text-slate-900 placeholder:text-slate-400 focus:border-rose-400 focus:outline-none focus:ring-4 focus:ring-rose-100"
            />
            <input
              id="rating"
              type="text"
              name="rating"
              placeholder="e.g. 4.5"
              required
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-base text-slate-900 placeholder:text-slate-400 focus:border-rose-400 focus:outline-none focus:ring-4 focus:ring-rose-100"
            />
            <input
              id="image"
              type="file"
              name="image"
              accept="image/*"
              required
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-base text-slate-900 placeholder:text-slate-400 focus:border-rose-400 focus:outline-none focus:ring-4 focus:ring-rose-100"
            />
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-xl bg-rose-500 px-5 py-3 text-base font-semibold text-white shadow-lg shadow-rose-500/30 transition hover:bg-rose-600"
            >
              Continue <span aria-hidden="true" class="ml-2">&#8594;</span>
            </button>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>
