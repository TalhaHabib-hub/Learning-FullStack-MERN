<%- include('partials/head.ejs') %>
  <body class="min-h-screen bg-gradient-to-br from-emerald-50 via-white to-rose-50 text-slate-800">
    <%- include('partials/navBar.ejs') %>

    <main class="mx-auto flex max-w-4xl items-center justify-center px-6 py-16">
      <section
        class="w-full rounded-3xl bg-white p-8 text-center shadow-xl shadow-emerald-100 ring-1 ring-emerald-100 md:p-12"
      >
        <p
          class="mb-3 text-xs font-semibold uppercase tracking-[0.28em] text-emerald-500"
        >
          All set
        </p>
        <h1
          class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl"
        >
         <%= homeNow %> is registered.
        </h1>
        <p class="mt-4 text-lg text-slate-600">
          Thanks for opening your space to guests.
        </p>
        <a
          href="/"
          class="mt-8 inline-flex items-center rounded-full bg-emerald-500 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-emerald-500/30 transition hover:bg-emerald-600"
        >
          Go to home <span aria-hidden="true" class="ml-2">&#8594;</span>
        </a>
      </section>
    </main>
  </body>
</html>
