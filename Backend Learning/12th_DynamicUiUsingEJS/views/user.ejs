<%- include('partials/head.ejs') %>
  <body class="min-h-screen bg-gradient-to-br from-rose-50 via-white to-slate-100 text-slate-800">
    <%- include('partials/navBar.ejs') %>

    <main class="mx-auto max-w-6xl space-y-8 px-6 py-10 md:py-14">
      <section class="rounded-3xl bg-white p-8 shadow-xl shadow-slate-200/60 ring-1 ring-slate-200 md:p-12">
<!-- ============ HERO SECTION ============ -->
<section class="px-4 py-8 sm:px-8">
  <div
    id="hero-slider"
    class="relative overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-xl shadow-slate-200/60"
  >
    <!-- Background slides (fill the whole card) -->
    <div class="absolute inset-0">
      <div class="hero-slide absolute inset-0 bg-cover bg-center opacity-100"
           style="background-image:url('https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=1920&q=80'); transition: opacity 1800ms ease-in-out;"></div>
      <div class="hero-slide absolute inset-0 bg-cover bg-center opacity-0"
           style="background-image:url('https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=1920&q=80'); transition: opacity 1800ms ease-in-out;"></div>
      <div class="hero-slide absolute inset-0 bg-cover bg-center opacity-0"
           style="background-image:url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1920&q=80'); transition: opacity 1800ms ease-in-out;"></div>
      <div class="hero-slide absolute inset-0 bg-cover bg-center opacity-0"
           style="background-image:url('https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1920&q=80'); transition: opacity 1800ms ease-in-out;"></div>
      <div class="hero-slide absolute inset-0 bg-cover bg-center opacity-0"
           style="background-image:url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80'); transition: opacity 1800ms ease-in-out;"></div>

      <!-- White fade so the dark text stays readable -->
      <div class="absolute inset-0 bg-white/85 md:bg-transparent md:bg-gradient-to-r md:from-white md:via-white/85 md:to-transparent"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 px-8 py-12 sm:px-12 sm:py-14">
      <p class="text-xs font-medium uppercase tracking-[0.3em] text-rose-500">
        A place to begin
      </p>

      <h1 class="mt-5 max-w-xl text-5xl font-extrabold leading-[1.05] tracking-tight text-slate-900 sm:text-6xl">
        Make room for a better stay.
      </h1>

      <p class="mt-5 max-w-md text-lg text-slate-600">
        Your next chapter starts with a place that feels like yours.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/host/add_home"
          class="inline-flex items-center rounded-full bg-rose-500 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-rose-500/30 transition hover:bg-rose-600"
        >
          Add your home <span aria-hidden="true" class="ml-2">+</span>
        </a>
        <a
          href="#added-homes"
          class="inline-flex items-center rounded-full border border-slate-200 bg-white/70 px-6 py-3 text-base font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50"
        >
          Explore homes
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const slides = document.querySelectorAll('#hero-slider .hero-slide');
    if (slides.length < 2) return;

    // Preload so the fade never shows a blank frame
    slides.forEach((s) => {
      const url = s.style.backgroundImage.slice(5, -2);
      const img = new Image();
      img.src = url;
    });

    let current = 0;
    setInterval(() => {
      const next = (current + 1) % slides.length;
      slides[next].classList.replace('opacity-0', 'opacity-100'); // fade next in
      slides[current].classList.replace('opacity-100', 'opacity-0'); // fade current out
      current = next;
    }, 5000);
  })();
</script>
<!-- ============ END HERO ============ -->

      <section id="added-homes" class="rounded-3xl bg-white p-8 shadow-xl shadow-slate-200/60 ring-1 ring-slate-200 md:p-10">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-rose-500">
              Your collection
            </p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 md:text-3xl">
              Added Homes
            </h2>
          </div>
          <% if (addedHomes.length > 0) { %>
            <p class="text-sm font-medium text-slate-500">
              <%= addedHomes.length %> <%= addedHomes.length === 1 ? 'home' : 'homes' %>
            </p>
          <% } %>
        </div>

        <% if (addedHomes.length > 0) { %>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <% addedHomes.forEach((home, homeIndex) => { %>
              <li class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-rose-200 hover:shadow-xl hover:shadow-rose-100/70">
                <div class="relative aspect-[4/3] overflow-hidden bg-rose-100">
                  <% if (home.image) { %>
                    <img
                      src="<%= home.image %>"
                      alt="<%= home.addedHome %>"
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    />
                  <% } else { %>
                    <div class="flex h-full items-center justify-center bg-gradient-to-br from-rose-100 via-rose-50 to-slate-100 text-6xl text-rose-300" aria-hidden="true">
                      &#8962;
                    </div>
                  <% } %>
                  <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-slate-950/50 to-transparent" aria-hidden="true"></div>
                  <div class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full bg-white/95 px-3 py-1.5 text-xs font-semibold text-rose-700 shadow-sm backdrop-blur">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-rose-100 text-sm text-rose-600" aria-hidden="true">&#8962;</span>
                    Your listing
                  </div>
                </div>
                <div class="space-y-3 p-5">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="break-words text-lg font-semibold text-slate-900 transition group-hover:text-rose-700">
                      <%= home.addedHome %>
                    </h3>
                    <p class="shrink-0 rounded-full bg-rose-50 px-3 py-1 text-sm font-semibold text-rose-700">
                      <%= home.pricePerNight %> <span class="font-normal text-rose-600">/ night</span>
                    </p>
                  </div>
                  <p class="text-sm text-slate-600">
                    <span class="font-semibold text-slate-700"><%= home.location %></span>
                  </p>
                  <div class="flex items-center justify-between border-t border-slate-100 pt-3">
                    <p class="text-sm font-medium text-slate-600">Guest rating</p>
                    <p class="rounded-full bg-amber-50 px-3 py-1 text-sm font-semibold text-amber-700">
                      <span aria-hidden="true">&#9733;</span> <%= home.rating %>/5
                    </p>
                  </div>
                  <form action="/host/delete_home/<%= homeIndex %>" method="post">
                    <button
                      type="submit"
                      class="w-full rounded-xl border border-rose-200 px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:border-rose-300 hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-400 focus:ring-offset-2"
                    >
                      Remove listing
                    </button>
                  </form>
                </div>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <div class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center">
            <p class="text-lg font-semibold text-slate-800">Your collection starts here</p>
            <p class="mt-2 text-sm text-slate-600">Add a home and it will appear here.</p>
            <a
              href="/host/add_home"
              class="mt-5 inline-flex items-center rounded-full bg-rose-500 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-rose-600"
            >
              Add your first home
            </a>
          </div>
        <% } %>
      </section>
    </main>
  </body>
</html>
