<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
    <%- include('../partials/nav') %>
    <main class="container mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <header class="mb-8">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-red-500">The store</p>
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Reserve your home</h1>
        <p class="mt-3 text-gray-600">Enter your details and preferred dates to submit a reservation.</p>
      </header>

      <form id="reserveForm" class="space-y-5 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
        <div>
          <label for="selectedRoom" class="mb-2 block text-sm font-medium text-gray-700">Selected home</label>
          <input id="selectedRoom" name="room" readonly class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 text-gray-700 focus:outline-none" />
          <p id="roomPrice" class="mt-2 text-sm font-semibold text-gray-700"></p>
        </div>
        <div>
          <label for="guest-name" class="mb-2 block text-sm font-medium text-gray-700">Your full name</label>
          <input id="guest-name" name="name" required placeholder="Enter your name" class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder:text-gray-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
        </div>
        <div>
          <label for="guest-email" class="mb-2 block text-sm font-medium text-gray-700">Email address</label>
          <input id="guest-email" type="email" name="email" required placeholder="you@example.com" class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder:text-gray-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="checkin" class="mb-2 block text-sm font-medium text-gray-700">Check-in date</label>
            <input id="checkin" type="date" name="checkin" required class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
          </div>
          <div>
            <label for="checkout" class="mb-2 block text-sm font-medium text-gray-700">Check-out date</label>
            <input id="checkout" type="date" name="checkout" required class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
          </div>
        </div>
        <div>
          <label for="guests" class="mb-2 block text-sm font-medium text-gray-700">Number of guests</label>
          <select id="guests" name="guests" class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100">
            <option>1</option>
            <option selected>2</option>
            <option>3</option>
            <option>4</option>
          </select>
        </div>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <button type="submit" class="rounded-lg bg-red-500 px-5 py-3 font-semibold text-white transition hover:bg-red-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">Submit reservation</button>
          <p id="reserveMessage" class="text-sm text-gray-600" aria-live="polite"></p>
        </div>
      </form>
    </main>
  </body>
</html>
