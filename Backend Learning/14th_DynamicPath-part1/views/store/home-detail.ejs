<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
    <%- include('../partials/nav') %>
    <main class="container mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <header class="mb-8">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-red-500">The store</p>
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Home details</h1>
      </header>
      <section class="grid grid-cols-2 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
        <div class="min-h-72 overflow-hidden">
          <img
            src="<%= home.url %>"
            alt="Photo of <%= home.houseName %>"
            class="h-full min-h-72 w-full object-cover"
          />
        </div>
        <div class="flex flex-col justify-center p-6 sm:p-8">
          <h2 class="text-2xl font-bold text-gray-900"><%= home.houseName %></h2>
          <p class="mt-3 text-gray-600">
            <span class="font-medium text-gray-700">Location:</span> <%= home.location %>
          </p>
          <div class="mt-6 border-t border-gray-100 pt-5">
            <span class="text-3xl font-bold text-gray-900">$<%= home.price %></span>
            <span class="text-sm text-gray-500">per night</span>
          </div>
          <div class="mt-6 flex items-center gap-3">
            <button type="button" class="inline-flex flex-1 items-center justify-center rounded-lg bg-red-500 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-red-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">
              Book Now
            </button>
            <button type="button" aria-label="Add to favorites" title="Add to favorites" class="inline-flex h-12 w-12 items-center justify-center rounded-lg border border-pink-100 bg-pink-50 text-pink-600 transition hover:border-pink-200 hover:bg-pink-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pink-600">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />
              </svg>
            </button>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
