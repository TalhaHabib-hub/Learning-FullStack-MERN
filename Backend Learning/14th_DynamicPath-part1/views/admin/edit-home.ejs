<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
    <%- include('../partials/nav') %>
    <main class="container mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <header class="mb-8">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-red-500">Administration</p>
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Edit a home</h1>
        <p class="mt-3 text-gray-600">Update the details for a registered property.</p>
      </header>

      <form id="adminForm" class="space-y-5 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
        <div>
          <label for="room-name" class="mb-2 block text-sm font-medium text-gray-700">Home name</label>
          <input id="room-name" type="text" required placeholder="e.g. Mountain View Home" class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder:text-gray-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
        </div>
        <div>
          <label for="room-type" class="mb-2 block text-sm font-medium text-gray-700">Home type</label>
          <select id="room-type" class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100">
            <option>Classic Home</option>
            <option>Deluxe Home</option>
            <option>Family Home</option>
          </select>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="room-price" class="mb-2 block text-sm font-medium text-gray-700">Price per night</label>
            <input id="room-price" type="number" min="1" required placeholder="8500" class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder:text-gray-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
          </div>
          <div>
            <label for="room-guests" class="mb-2 block text-sm font-medium text-gray-700">Maximum guests</label>
            <input id="room-guests" type="number" min="1" required value="2" class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
          </div>
        </div>
        <div>
          <label for="room-image" class="mb-2 block text-sm font-medium text-gray-700">Image URL</label>
          <input id="room-image" type="url" placeholder="https://example.com/home.jpg" class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder:text-gray-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
        </div>
        <div>
          <label for="room-description" class="mb-2 block text-sm font-medium text-gray-700">Description</label>
          <textarea id="room-description" rows="4" placeholder="Describe the home and its facilities" class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 placeholder:text-gray-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100"></textarea>
        </div>
        <div class="flex flex-wrap gap-3 pt-2">
          <button type="submit" class="rounded-lg bg-red-500 px-5 py-3 font-semibold text-white transition hover:bg-red-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">Save changes</button>
          <a href="/admin/home-list" class="rounded-lg border border-gray-300 px-5 py-3 font-semibold text-gray-700 transition hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">Back to home list</a>
        </div>
        <div id="adminMessage" class="text-sm text-gray-600" aria-live="polite"></div>
      </form>
    </main>
  </body>
</html>
