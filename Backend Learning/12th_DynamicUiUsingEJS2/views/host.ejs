<%- include('partials/head.ejs') %>
  <body class="flex min-h-screen flex-col bg-gradient-to-br from-rose-400 via-pink-300 to-fuchsia-400 text-slate-800">
    <%- include('partials/navBar.ejs') %>

    <main class="mx-auto flex w-full max-w-5xl flex-1 items-center px-6 py-10 md:py-14">
      <section
        class="w-full rounded-3xl border border-white/70 bg-white p-8 shadow-2xl shadow-rose-950/15 ring-1 ring-rose-100 md:p-12"
      >
        <p
          class="mb-3 text-xs font-semibold uppercase tracking-[0.28em] text-rose-500"
        >
          HOST WITH US
        </p>
        <h1
          class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl"
        >
          Share your space.
        </h1>
        <p class="mt-4 max-w-lg text-lg text-slate-600">
          Create a welcoming listing and help guests find a place they will love.
        </p>

        <form method="POST" action="/host/add_home" class="mt-8 grid max-w-3xl gap-5 sm:grid-cols-2" enctype="multipart/form-data">
          <div>
            <label for="addedHome" class="mb-2 block text-sm font-medium text-slate-700">Home name</label>
            <input
              id="addedHome"
              type="text"
              name="addedHome"
              placeholder="e.g. The garden house"
              required
              class="w-full rounded-xl border border-rose-200 bg-rose-50/60 px-4 py-3 text-base text-slate-900 placeholder:text-slate-400 transition focus:border-rose-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-rose-100"
            />
          </div>
          <div>
            <label for="pricePerNight" class="mb-2 block text-sm font-medium text-slate-700">Price per night</label>
            <input
              id="pricePerNight"
              type="text"
              name="pricePerNight"
              placeholder="e.g. $100"
              required
              class="w-full rounded-xl border border-rose-200 bg-rose-50/60 px-4 py-3 text-base text-slate-900 placeholder:text-slate-400 transition focus:border-rose-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-rose-100"
            />
          </div>
          <div>
            <label for="location" class="mb-2 block text-sm font-medium text-slate-700">Location</label>
            <input
              id="location"
              type="text"
              name="location"
              placeholder="e.g. New York, NY"
              required
              class="w-full rounded-xl border border-rose-200 bg-rose-50/60 px-4 py-3 text-base text-slate-900 placeholder:text-slate-400 transition focus:border-rose-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-rose-100"
            />
          </div>
          <div>
            <label for="rating" class="mb-2 block text-sm font-medium text-slate-700">Guest rating</label>
            <input
              id="rating"
              type="text"
              name="rating"
              placeholder="e.g. 4.5"
              required
              class="w-full rounded-xl border border-rose-200 bg-rose-50/60 px-4 py-3 text-base text-slate-900 placeholder:text-slate-400 transition focus:border-rose-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-rose-100"
            />
          </div>
          <div class="sm:col-span-2">
            <label for="image" class="mb-2 block text-sm font-medium text-slate-700">Home photo</label>
            <input
              id="image"
              type="file"
              name="image"
              accept="image/*"
              required
              class="w-full rounded-xl border border-rose-200 bg-rose-50/60 px-4 py-3 text-base text-slate-900 file:mr-4 file:rounded-full file:border-0 file:bg-rose-100 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-rose-700 transition focus:border-rose-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-rose-100"
            />
          </div>
          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-xl bg-rose-600 px-5 py-3 text-base font-semibold text-white shadow-lg shadow-rose-600/25 transition hover:bg-rose-700 focus:outline-none focus:ring-4 focus:ring-rose-200 sm:col-span-2"
          >
            Continue <span aria-hidden="true" class="ml-2">&#8594;</span>
          </button>
        </form>
      </section>
    </main>
    <%- include('partials/footer.ejs') %>
  </body>
</html>
