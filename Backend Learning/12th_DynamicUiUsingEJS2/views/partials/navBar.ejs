<header class="sticky top-0 z-30 px-4 pt-4 sm:px-6">
  <nav aria-label="Main navigation" class="mx-auto flex max-w-6xl items-center justify-between gap-3 rounded-2xl border border-white/70 bg-white/90 px-4 py-3 shadow-lg shadow-rose-900/10 backdrop-blur-xl sm:px-7">
    <a href="/" class="inline-flex shrink-0 items-center gap-2.5 text-lg font-extrabold tracking-tight text-rose-700 sm:gap-3 sm:text-2xl">
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-rose-500 to-fuchsia-600 text-white shadow-md shadow-rose-500/25 sm:h-10 sm:w-10" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg">
          <path d="m3.75 10.5 8.25-7 8.25 7v9.75a.75.75 0 0 1-.75.75h-15a.75.75 0 0 1-.75-.75V10.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M9 21v-7.5h6V21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span>Airbnb</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <% if (pageTitle === 'Home') { %>
        <a href="#added-homes" class="hidden rounded-full px-4 py-2 text-sm font-semibold text-rose-800 transition hover:bg-rose-50 sm:inline-flex">
          Explore homes
        </a>
        <a href="/host/add_home" class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-full bg-rose-600 px-3 py-2 text-xs font-semibold text-white shadow-md shadow-rose-600/20 transition hover:bg-rose-700 focus:outline-none focus:ring-4 focus:ring-rose-200 sm:px-5 sm:py-2.5 sm:text-sm">
          <span class="sm:hidden">Host</span><span class="hidden sm:inline">List your home</span><span aria-hidden="true">+</span>
        </a>
      <% } else if (pageTitle === 'Become a host') { %>
        <a href="/" class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-full border border-rose-200 bg-white px-3 py-2 text-xs font-semibold text-rose-800 transition hover:bg-rose-50 focus:outline-none focus:ring-4 focus:ring-rose-100 sm:px-5 sm:py-2.5 sm:text-sm">
          <span aria-hidden="true">&larr;</span><span class="sm:hidden">Homes</span><span class="hidden sm:inline">Back to homes</span>
        </a>
      <% } else { %>
        <a href="/" class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-full bg-rose-600 px-3 py-2 text-xs font-semibold text-white shadow-md shadow-rose-600/20 transition hover:bg-rose-700 focus:outline-none focus:ring-4 focus:ring-rose-200 sm:px-5 sm:py-2.5 sm:text-sm">
          <span class="sm:hidden">Home</span><span class="hidden sm:inline">Explore homes</span><span aria-hidden="true">&rarr;</span>
        </a>
      <% } %>
    </div>
  </nav>
</header>