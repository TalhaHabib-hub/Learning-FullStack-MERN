<%- include('partials/head.ejs') %>
  <body class="flex min-h-screen flex-col bg-gradient-to-br from-rose-400 via-pink-300 to-fuchsia-400 text-white">
    <%- include('partials/navBar.ejs') %>

    <main class="mt-6 rounded-2xl border border-dashed border-white/50 bg-white/10 px-6 py-10 text-center">
      <section class="mt-6 rounded-2xl border border-dashed border-white/50 bg-white/10 px-6 py-10 text-center">
<!-- ============ HERO SECTION ============ -->

<!-- Content -->
 <div class="relative z-10 px-8 py-12 sm:px-12 sm:py-14">
   <p class="text-xs font-semibold uppercase tracking-[0.3em] text-white">
     A place to begin
   </p>

   <h1 class="mt-5 max-w-xl text-5xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-6xl">
     Make room for a better stay.
   </h1>

   <p class="mt-5 max-w-md text-lg text-white/90">
     Your next chapter starts with a place that feels like yours.
   </p>

   <div class="mt-8 flex flex-wrap items-center gap-4">
     <a
       href="/host/add_home"
       class="inline-flex items-center rounded-full bg-white px-6 py-3 text-base font-semibold text-rose-700 shadow-lg shadow-rose-950/20 transition hover:bg-rose-50"
     >
       Add your home <span aria-hidden="true" class="ml-2">+</span>
     </a>
     <a
       href="#added-homes"
       class="inline-flex items-center rounded-full border border-white/70 bg-white/10 px-6 py-3 text-base font-semibold text-white transition hover:bg-white/20"
     >
       Explore homes
     </a>
   </div>
 </div>

<script>
  (function () {
    const slides = document.querySelectorAll('#hero-slider .hero-slide');
    if (slides.length < 2) return;

    // Preload so the fade never shows a blank frame
    slides.forEach((s) => {
      const url = s.style.backgroundImage.slice(5, -2);
      const img = new Image();
      img.src = url;
    });

    let current = 0;
    setInterval(() => {
      const next = (current + 1) % slides.length;
      slides[next].classList.replace('opacity-0', 'opacity-100'); // fade next in
      slides[current].classList.replace('opacity-100', 'opacity-0'); // fade current out
      current = next;
    }, 5000);
  })();
</script>
<!-- ============ END HERO ============ -->

      <section id="added-homes" class="rounded-3xl bg-rose-600 p-8 shadow-xl shadow-rose-900/25 ring-1 ring-white/30 md:p-10">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-white">
              Your collection
            </p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-white md:text-3xl">
              Added Homes
            </h2>
          </div>
          <% if (addedHomes.length > 0) { %>
            <p class="text-sm font-medium text-white/80">
              <%= addedHomes.length %> <%= addedHomes.length === 1 ? 'home' : 'homes' %>
            </p>
          <% } %>
        </div>

        <% if (addedHomes.length > 0) { %>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <% addedHomes.forEach((home, homeIndex) => { %>
              <li class="group overflow-hidden rounded-3xl border border-white/30 bg-rose-500 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-white/70 hover:shadow-xl hover:shadow-rose-950/30">
                <div class="relative aspect-[4/3] overflow-hidden bg-rose-700">
                  <% if (home.image) { %>
                    <img
                      src="<%= home.image %>"
                      alt="<%= home.addedHome %>"
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    />
                  <% } else { %>
                    <div class="flex h-full items-center justify-center bg-gradient-to-br from-rose-700 via-rose-600 to-fuchsia-700 text-6xl text-white/70" aria-hidden="true">
                      &#8962;
                    </div>
                  <% } %>
                  <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-slate-950/50 to-transparent" aria-hidden="true"></div>
                  <div class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full bg-white/95 px-3 py-1.5 text-xs font-semibold text-rose-700 shadow-sm backdrop-blur">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-rose-100 text-sm text-rose-600" aria-hidden="true">&#8962;</span>
                    Your listing
                  </div>
                </div>
                <div class="space-y-3 p-5">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="break-words text-lg font-semibold text-white transition group-hover:text-rose-100">
                      <%= home.addedHome %>
                    </h3>
                    <p class="shrink-0 rounded-full bg-white px-3 py-1 text-sm font-semibold text-rose-700">
                      <%= home.pricePerNight %> <span class="font-normal text-rose-600">/ night</span>
                    </p>
                  </div>
                  <p class="text-sm text-white/80">
                    <span class="font-semibold text-white"><%= home.location %></span>
                  </p>
                  <div class="flex items-center justify-between border-t border-white/20 pt-3">
                    <p class="text-sm font-medium text-white/80">Guest rating</p>
                    <p class="rounded-full bg-amber-50 px-3 py-1 text-sm font-semibold text-amber-700">
                      <span aria-hidden="true">&#9733;</span> <%= home.rating %>/5
                    </p>
                  </div>
                  <form action="/host/delete_home/<%= homeIndex %>" method="post">
                    <button
                      type="submit"
                      class="w-full rounded-xl border border-white/70 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-white hover:text-rose-700 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-rose-500"
                    >
                      Remove listing
                    </button>
                  </form>
                </div>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <div class="mt-6 rounded-2xl border border-dashed border-white/50 bg-white/10 px-6 py-10 text-center">
            <p class="text-lg font-semibold text-white">Your collection starts here</p>
            <p class="mt-2 text-sm text-white/80">Add a home and it will appear here.</p>
            <a
              href="/host/add_home"
              class="mt-5 inline-flex items-center rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-50"
            >
              Add your first home
            </a>
          </div>
        <% } %>
      </section>
    </main>
    <%- include('partials/footer.ejs') %>
  </body>
</html>
