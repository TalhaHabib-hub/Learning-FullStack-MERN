<%- include('partials/head.ejs') %>
  <body class="flex min-h-screen flex-col bg-gradient-to-br from-rose-400 via-pink-300 to-fuchsia-400 text-slate-800">
    <%- include('partials/navBar.ejs') %>

    <main class="mx-auto flex w-full max-w-4xl flex-1 items-center justify-center px-6 py-12 md:py-16">
      <section
        class="w-full rounded-3xl border border-white/70 bg-white p-8 text-center shadow-2xl shadow-rose-950/15 ring-1 ring-rose-100 md:p-12"
      >
        <p
          class="mb-3 text-xs font-semibold uppercase tracking-[0.28em] text-rose-600"
        >
          All set
        </p>
        <h1
          class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl"
        >
         <%= homeNow %> is registered.
        </h1>
        <p class="mt-4 text-lg text-slate-600">
          Thanks for opening your space to guests.
        </p>
        <a
          href="/"
          class="mt-8 inline-flex items-center rounded-full bg-rose-600 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-rose-600/25 transition hover:bg-rose-700 focus:outline-none focus:ring-4 focus:ring-rose-200"
        >
          Go to home <span aria-hidden="true" class="ml-2">&#8594;</span>
        </a>
      </section>
    </main>
    <%- include('partials/footer.ejs') %>
  </body>
</html>
