<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
    <%- include('../partials/nav') %>
    <main class="container mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <header class="mb-10 text-center">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-red-500">Find your next stay</p>
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          Explore our registered homes
        </h1>
        <p class="mx-auto mt-3 max-w-2xl text-gray-600">
          Browse welcoming places for your next getaway.
        </p>
      </header>
      <ul class="grid list-none gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% registeredHomes.forEach(home => { %>
          <li class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
            <div class="overflow-hidden">
              <img
                src="<%= home.url %>"
                alt="Photo of <%= home.houseName %>"
                class="h-60 w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-5">
              <h2 class="truncate text-xl font-semibold text-gray-900"><%= home.houseName %></h2>
              <p class="mt-2 text-sm text-gray-500">
                <span class="font-medium text-gray-700">Location:</span> <%= home.location %>
              </p>
              <div class="mt-5 flex items-baseline gap-1 border-t border-gray-100 pt-4">
                <span class="text-2xl font-bold text-gray-900">$<%= home.price %></span>
                <span class="text-sm text-gray-500">per night</span>
              </div>
            </div>
          </li>
        <% }) %>
      </ul>
    </main>
  </body>
</html>
