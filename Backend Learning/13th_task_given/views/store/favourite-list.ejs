<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
    <%- include('../partials/nav') %>
    <main class="container mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <header class="mb-10">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-red-500">Your account</p>
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Favorite homes</h1>
        <p class="mt-3 max-w-2xl text-gray-600">Homes you save will be collected here for easy access.</p>
      </header>
      <div id="favouriteGrid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
      <p class="mt-8 text-sm text-gray-500">Your saved homes will appear here.</p>

            <% if (registeredHomes.length === 0) { %>
        <section class="rounded-2xl border border-dashed border-gray-300 bg-white px-6 py-12 text-center">
          <h2 class="text-xl font-semibold text-gray-900">No homes registered yet</h2>
          <p class="mt-2 text-gray-600">Add your first home to see it listed here.</p>
        </section>
      <% } else { %>
        <ul class="grid list-none gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% registeredHomes.forEach(home => { %>
            <li class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
              <img src="<%= home.url %>" alt="Photo of <%= home.houseName %>" class="h-52 w-full bg-gray-100 object-cover" />
              <div class="p-5">
                <h2 class="truncate text-xl font-semibold text-gray-900"><%= home.houseName %></h2>
                <p class="mt-2 text-sm text-gray-500"><span class="font-medium text-gray-700">Location:</span> <%= home.location %></p>
                <p class="mt-4 border-t border-gray-100 pt-4 text-xl font-bold text-gray-900">$<%= home.price %><span class="ml-1 text-sm font-normal text-gray-500">per night</span></p>
                <div class="mt-4 flex justify-end gap-2" aria-label="Home actions">
                  <button type="button" aria-label="Delete home" title="Delete home" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-red-100 bg-red-50 text-red-600 transition hover:border-red-200 hover:bg-red-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18m-2 0-.9 14.1a2 2 0 0 1-2 1.9H7.9a2 2 0 0 1-2-1.9L5 6m4 0V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2m-5 4v7m4-7v7" />
                    </svg>
                  </button>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
  </body>
</html>
